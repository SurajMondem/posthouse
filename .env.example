# Copy to .env (git-ignored) and fill in only what you use.

# ElevenLabs (voice.provider = "elevenlabs"): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: a whisper.cpp ggml model for exact word timings with local voices
# WHISPER_MODEL=/absolute/path/to/ggml-base.en.bin
